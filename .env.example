# From Supabase: Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Never prefix with NEXT_PUBLIC_. Used to create staff accounts.
SUPABASE_SECRET_KEY=sb_secret_...

# Staff log in with a username; Supabase stores it as username@<this domain>.
# No emails are ever sent to these addresses.
STAFF_LOGIN_DOMAIN=users.hebe.in
